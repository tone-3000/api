# ── Required ──────────────────────────────────────────────────────────────────
# Your publishable key from TONE3000 Settings → API Keys
# Used as the default for all demos. For local dev, one key is sufficient.
VITE_PUBLISHABLE_KEY=t3k_pub_your_key_here

# Per-demo keys. Optional; they fall back to VITE_PUBLISHABLE_KEY if not set.
# In production, each demo uses a separate key so the partner banner
# shows the correct company name (Acme Inc, Beacon Inc, Chord Inc, Echo Inc).
# VITE_PUBLISHABLE_KEY_SELECT=t3k_pub_acme_key_here
# VITE_PUBLISHABLE_KEY_LOAD=t3k_pub_beacon_key_here
# VITE_PUBLISHABLE_KEY_FULL=t3k_pub_chord_key_here
# Presigned-uploads demo (Echo Inc). The key's account owns the tones the demo
# uploads to, so use a key whose user has at least one tone.
# VITE_PUBLISHABLE_KEY_UPLOAD=t3k_pub_echo_key_here

# ── Optional (have defaults) ─────────────────────────────────────────────────
# TONE3000 API domain (default: https://www.tone3000.com)
# Leave this commented out to use production. Uncomment it only to run the demos
# against a local Next.js dev server.
# This exact name is the only one read; VITE_TONE3000_API_DOMAIN is not.
#
# A local server needs its own .env.local with NEXT_PUBLIC_SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY and
# NEXT_PUBLIC_POSTHOG_KEY. Without the PostHog key every /api/v1 route 500s at
# import. See "Running this locally against a dev stack" in the README.
# VITE_T3K_API_DOMAIN=http://localhost:3000

# The URL where TONE3000 will redirect after completing any OAuth flow.
# Must match a registered redirect URI in your TONE3000 API key settings.
# (default: http://localhost:3001)
VITE_REDIRECT_URI=http://localhost:3001
