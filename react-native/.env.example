# Copy to .env (gitignored) and restart Metro after changes.

# Your publishable key from https://www.tone3000.com/settings
EXPO_PUBLIC_T3K_PUBLISHABLE_KEY=t3k_pub_your_key_here

# Optional. Must match a redirect URI registered on your key, if any are registered.
# EXPO_PUBLIC_T3K_REDIRECT_URI=tone3000-example://oauth/callback

# Optional. Defaults to https://www.tone3000.com
# EXPO_PUBLIC_T3K_API_DOMAIN=https://www.tone3000.com
