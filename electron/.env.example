# Copy to .env and fill in.

# Your publishable key from TONE3000 Settings → API Keys.
VITE_PUBLISHABLE_KEY=t3k_pub_your_key_here

# OAuth redirect URI. Nothing serves this URL in a desktop app: the main process
# intercepts the navigation to it inside the embedded TONE3000 view and reads the
# authorization code off the query string (see src/main/oauth.ts).
# If your key has registered redirect URIs, this must be one of them.
# VITE_REDIRECT_URI=http://localhost:3001/callback

# Optional: override the API origin (default https://www.tone3000.com).
# VITE_T3K_API_DOMAIN=http://localhost:3000
